GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# If your frontend is served separately from the NextAuth backend, set this
# to the full auth server URL (e.g. https://auth.example.com). `app/layout.jsx`
# injects `window.__AUTH_BASE_URL__` from this var so the static client can
# call the correct `/api/auth` endpoints.
NEXT_PUBLIC_AUTH_BASE_URL=

# Azure OpenAI (recommended format for this repo: endpoint root only — no /openai/... path)
# Example values (do NOT commit real secrets):
# AZURE_OPENAI_ENDPOINT=https://my-openai-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-11-20
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.6-sol
# AZURE_OPENAI_API_KEY=replace-with-your-key

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.6-sol
AZURE_OPENAI_API_KEY=

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
